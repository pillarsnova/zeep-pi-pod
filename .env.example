# Identity of this physical pod. Every pod in a fleet must be unique.
POD_ID=pod-01

# Persistent lighting outputs (BCM numbering). Both start LOW after boot.
# BCM4 is physical header pin 7 and must drive a MOSFET/relay, not the lamp.
GPIO_LED=22
GPIO_STAR_LIGHT=4

# ZEEP account API used for occupant and online-admin authentication.
ZEEP_API_BASE_URL=https://api.zeep.world/api
ZEEP_API_TIMEOUT=12
ZEEP_ADMIN_ROLES=admin

# Upload a finished Session to the ZEEP account so it appears in the user's
# sleep history. Service-to-service: this key must equal SLEEP_AI_API_KEY on
# the backend, and the device UUID must already be registered there. Leave
# either empty to disable the upload; nothing is queued and nothing is lost
# locally. A failed upload is retried at boot and every sweep interval.
ZEEP_INGEST_API_KEY=
ZEEP_DEVICE_ID=
ZEEP_INGEST_SWEEP_SECONDS=900
# IANA zone this Pod stands in, used by the account backend to decide which
# night a Session belongs to. Empty = use the timezone on the user's profile.
POD_TIMEZONE=Asia/Bangkok

# Browser sessions. Set AUTH_SECURE_COOKIE=1 after HTTPS is enabled.
AUTH_SESSION_TTL_SECONDS=43200
AUTH_SECURE_COOKIE=0

# A Login may occupy the Pod, but recording starts only after the user stays
# on bed for BED_START_SECONDS and the BCG reports sane HR + RR in this many
# consecutive new packets. Display-held vital values do not count.
BED_START_SECONDS=20
SESSION_VITAL_START_PACKETS=3

# Canonical analytical/persistence cadence. Raw USB Serial/MQTT readers and
# the 1-second local safety supervisor remain continuous/independent.
SLEEP_SAMPLE_SECONDS=10
SLEEP_WINDOW_SECONDS=60
SESSION_SAMPLE_SECONDS=10

# Multi-pod occupancy. Leave URL empty only for a single-pod installation.
# All pods must use the same coordinator URL/token to prevent one ZEEP account
# from occupying two pods at the same time.
OCCUPANCY_COORDINATOR_URL=
OCCUPANCY_COORDINATOR_TOKEN=
OCCUPANCY_LEASE_SECONDS=45
OCCUPANCY_RENEW_SECONDS=10
OCCUPANCY_COORDINATOR_TIMEOUT=4

# Optional offline admin. Store only a scrypt hash, never a plaintext password.
# Generate on an admin workstation:
#   python -c "from access_control import hash_password; print(hash_password('CHANGE-ME'))"
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD_HASH=
# Optional additional offline administrators. This JSON file must contain only
# scrypt hashes, be readable by the service account, and have mode 0600.
LOCAL_ADMIN_ACCOUNTS_FILE=data/local_admins.json

# Optional service-to-service admin token. Browser users do not use this.
API_TOKEN=

# ESP32 air-conditioner IR timing. Commands are serialized on the Pi; the
# longer Power-ON delay prevents the default temperature frame arriving while
# the appliance is still processing its ON frame.
CONTROLHUB1_MIN_IR_GAP_SECONDS=1.2
CONTROLHUB1_POWER_ON_SETTLE_SECONDS=2.0
# FAN is sent only after STATUS ACK; this brief settle lets the ESP command
# task wake before it transmits the fan-cycle IR frame.
CONTROLHUB1_FAN_WAKE_SETTLE_SECONDS=0.25
# Initial logical fan-cycle reference for this installation. The air
# conditioner has no physical feedback; Admin may correct 1..5 in Control
# Debug without transmitting IR.
AIRCON_FAN_LEVEL_DEFAULT=1

# Additive SHT3x-DIS correction in percentage points. Keep device-specific
# calibration in calibration.json when possible; env overrides that file.
HUMIDITY_RH_BIAS=-1.5

# Exploratory Sleep State auxiliary evidence. SPH0645 never changes a stage by
# itself: support is non-zero only when the same window also contains BCG
# amplitude change or bed motion. Keep support capped until paired-PSG G2.
SLEEP_ACOUSTIC_DISTURBANCE_DBA=55
SLEEP_ACOUSTIC_MIN_COVERAGE=0.50
SLEEP_ACOUSTIC_WAKE_SUPPORT_MAX=0.35

# ZEEP internal operating alerts; see
# docs/zeep-atmosphere-operating-basis-v1.0.md. These are not medical or
# universal health limits. A site may set APPROVED=1 only for the exact frozen
# policy/version deployed and must retain its separate G1 evidence.
SAFETY_THRESHOLD_BASIS_VERSION=ZEEP-ATMOSPHERE-OPS-v1.0
SAFETY_THRESHOLD_BASIS_APPROVED=1
SAFETY_CO2_WARN_PPM=1000
SAFETY_CO2_FAIR_MAX_PPM=1150
SAFETY_CO2_CRITICAL_PPM=1300
SAFETY_TEMP_WARN_MIN_C=17
SAFETY_TEMP_WARN_MAX_C=28
SAFETY_TEMP_CRITICAL_MIN_C=13
SAFETY_TEMP_CRITICAL_MAX_C=32
# Deprecated compatibility override for SAFETY_TEMP_CRITICAL_MAX_C.
SAFETY_MAX_TEMP_C=
SAFETY_REQUIRE_CO2=1
SAFETY_ARMED_DEFAULT=0

# Keep a bounded on-device recovery window. Each archive contains consistent
# sessions/BCG databases plus current user profiles and personal baselines.
BACKUP_RETENTION_COUNT=3
