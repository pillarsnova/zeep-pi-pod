{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeep.world/schemas/evidence-source-register-1.1.0.json",
  "title": "ZEEP Evidence Source Register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "library_version",
    "checked_on",
    "maintainer",
    "authority",
    "runtime_policy",
    "sources"
  ],
  "properties": {
    "$schema": {"const": "source-register.schema.json"},
    "schema_version": {"const": "1.1.0"},
    "library_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "checked_on": {"type": "string", "format": "date"},
    "maintainer": {"type": "string", "minLength": 1},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoritative", "scope", "human_view", "owner_role"],
      "properties": {
        "authoritative": {"const": true},
        "scope": {"type": "string", "minLength": 1},
        "human_view": {"const": "SOURCE_REGISTER.md"},
        "owner_role": {"type": "string", "minLength": 1}
      }
    },
    "runtime_policy": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked_on", "checked_by_role", "method"],
      "properties": {
        "checked_on": {"type": "string", "format": "date"},
        "checked_by_role": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "provenance",
        "title",
        "year",
        "identifiers",
        "source_url",
        "download_url",
        "local_file",
        "sha256",
        "access",
        "license",
        "use_in_zeep",
        "limitations"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{3}$"},
        "category": {"enum": ["sleep", "health-wellness", "indoor-air-voc", "who", "vendor"]},
        "provenance": {"$ref": "#/$defs/provenance"},
        "title": {"type": "string", "minLength": 1},
        "year": {"type": ["integer", "null"], "minimum": 1900, "maximum": 2100},
        "identifiers": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "source_url": {"type": "string", "pattern": "^https://[^/]+(?:/.*)?$"},
        "download_url": {"type": ["string", "null"]},
        "local_file": {
          "type": ["string", "null"],
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(?:pdf|xml)$"
        },
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "media_type": {"enum": ["application/pdf", "application/xml", "text/xml"]},
        "access": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "use_in_zeep": {"type": "string", "minLength": 1},
        "limitations": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"access": {"const": "downloadable"}}},
          "then": {
            "properties": {
              "download_url": {"type": "string", "pattern": "^https://[^/]+(?:/.*)?$"},
              "local_file": {"type": "string"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "else": {
            "properties": {
              "download_url": {"type": "null"},
              "local_file": {"type": "null"},
              "sha256": {"type": "null"}
            }
          }
        }
      ]
    }
  }
}
