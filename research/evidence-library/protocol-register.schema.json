{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeep.world/schemas/evidence-protocol-register-1.0.0.json",
  "title": "ZEEP Validation Protocol Register",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "checked_on", "authority", "protocols"],
  "properties": {
    "$schema": {"const": "protocol-register.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "checked_on": {"type": "string", "format": "date"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoritative", "scope", "owner_role"],
      "properties": {
        "authoritative": {"const": true},
        "scope": {"type": "string", "minLength": 1},
        "owner_role": {"type": "string", "minLength": 1}
      }
    },
    "protocols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "version", "document", "status", "owner_role", "required_gates", "release_rule", "gates"],
        "properties": {
          "id": {"type": "string", "pattern": "^ZEEP-[A-Z0-9-]+-[0-9]{3}$"},
          "title": {"type": "string", "minLength": 1},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "document": {"type": "string", "pattern": "^[^/]+\\.md$"},
          "status": {"enum": ["draft", "pending-approval", "approved", "retired"]},
          "owner_role": {"type": "string", "minLength": 1},
          "required_gates": {"type": "array", "items": {"enum": ["G1", "G3"]}, "minItems": 2, "maxItems": 2, "uniqueItems": true},
          "release_rule": {"type": "string", "minLength": 1},
          "gates": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "approver_role", "status", "signed_by", "signed_at", "evidence_reference"],
              "properties": {
                "id": {"enum": ["G1", "G3"]},
                "name": {"type": "string", "minLength": 1},
                "approver_role": {"type": "string", "minLength": 1},
                "status": {"enum": ["pending", "approved", "rejected", "expired"]},
                "signed_by": {"type": ["string", "null"]},
                "signed_at": {"type": ["string", "null"], "format": "date-time"},
                "evidence_reference": {"type": ["string", "null"]}
              }
            }
          }
        }
      }
    }
  }
}
